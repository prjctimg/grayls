{
  "name": "grayls",
  "displayName": "Grayscale Language Support",
  "description": "Language server for the Grayscale programming language: diagnostics, completion, hover, and go-to-definition",
  "version": "0.1.0",
  "publisher": "grayscale-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/grayscale-lang/grayls.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:gray"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gray",
        "aliases": [
          "Grayscale",
          "gray"
        ],
        "extensions": [
          ".gray"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gray",
        "scopeName": "source.gray",
        "path": "./syntaxes/gray.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.js",
    "build:native": "scriptc build src/native.ts -o out/grayls --emit=exe",
    "coverage:native": "scriptc coverage src/native.ts",
    "compile": "tsc -p tsconfig.json",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "scriptc": "^0.4.6",
    "typescript": "^5.4.0",
    "vscode-languageclient": "^9.0.1"
  }
}
